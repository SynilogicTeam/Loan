# MongoDB Connection
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/community-saas

# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/community-saas?retryWrites=true&w=majority

# Server Port
PORT=5001

# JWT Secret Key (Change this to a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Razorpay Keys (Optional - for payment gateway)
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Environment
NODE_ENV=development
